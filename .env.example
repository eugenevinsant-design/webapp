# Режим работы: dev (с --reload) или prod (без --reload)
APP_ENV=dev

# Подключение к PostgreSQL (asyncpg)
# Для локальной разработки (Docker): localhost:5432
# Для prod: замените на реальный хост/порт/пользователя/пароль
DATABASE_URL=postgresql+asyncpg://ecg_user:ecg_password@localhost:5432/ecg_analyzer

# Параметры PostgreSQL для docker-compose
POSTGRES_USER=ecg_user
POSTGRES_PASSWORD=ecg_password
POSTGRES_DB=ecg_analyzer
POSTGRES_PORT=5432

# Путь к папке с ЭКГ-файлами (.hea + .mat)
# Дефолт совпадает с текущим значением в ecg_loader.py
SIGNALS_DIR=./data/signals

# CORS: список origin'ов, которым разрешено обращаться к API
# Для dev: * (разрешить все)
# Для prod: укажите конкретные домены через запятую
ALLOWED_ORIGINS=*

# Пул соединений с БД (для 40 одновременных пользователей)
POOL_SIZE=10
MAX_OVERFLOW=20

# Секретный ключ (для будущей аутентификации, пока не используется)
SECRET_KEY=change-me-in-production

# Порт, на котором запускается FastAPI (внутри контейнера)
BACKEND_PORT=8000
