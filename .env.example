# Режим работы: dev (с --reload) или prod (без --reload)
APP_ENV=dev

# Подключение к PostgreSQL (asyncpg)
# Для локальной разработки (Docker): localhost:5432
# Для prod: замените на реальный хост/порт/пользователя/пароль
DATABASE_URL=postgresql+asyncpg://ecg_user:ecg_password@localhost:5432/ecg_analyzer

# Параметры PostgreSQL для docker-compose
POSTGRES_USER=ecg_user
POSTGRES_PASSWORD=ecg_password
POSTGRES_DB=ecg_analyzer
POSTGRES_PORT=5432

# Путь к папке с ЭКГ-файлами (.hea + .mat)
# Дефолт совпадает с текущим значением в ecg_loader.py
SIGNALS_DIR=./data/signals

# CORS: список origin'ов, которым разрешено обращаться к API
# Для dev: * (разрешить все)
# Для prod: укажите конкретные домены через запятую
ALLOWED_ORIGINS=*

# Пул соединений с БД (для 40 одновременных пользователей)
POOL_SIZE=10
MAX_OVERFLOW=20

# Секретный ключ (для будущей аутентификации, пока не используется)
SECRET_KEY=change-me-in-production

# Порт, на котором запускается FastAPI (внутри контейнера)
BACKEND_PORT=8000

# ---- LLM (vLLM, OpenAI-совместимый сервер) ----
# Внутри docker-compose backend ходит к vLLM по имени сервиса "llm".
# Для локального запуска без docker-compose: http://localhost:8000/v1
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=
LLM_TIMEOUT=120
# false -> при недоступности LLM backend возвращает 503 (без fallback)
LLM_FALLBACK_ON_ERROR=false

# ---- ML-бэкенд анализа ЭКГ ----
# deterministic — scipy-анализатор (работает без весов)
# torch — реальная модель (требует веса и analyze_with_torch)
ML_BACKEND=deterministic

# ---- vLLM (сервис llm в docker-compose) ----
# Модель, которую скачает vLLM (HuggingFace id) или локальный путь в ./models
VLLM_MODEL=${LLM_MODEL}
# Размер батча, макс. длина контекста, утилизация VRAM
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_TENSOR_PARALLEL_SIZE=1
# Токен HuggingFace (если модель gated, напр. Llama)
HF_TOKEN=
# Порт vLLM внутри контейнера
VLLM_PORT=8000
