# Режим работы: dev (с --reload) или prod (без --reload)
APP_ENV=dev

# Подключение к БД.
# ВАРИАНТ A — Docker (docker compose up): ОСТАВЬТЕ закомментированным!
#   docker-compose сам подставит postgresql+asyncpg://...@postgres:5432/...
#   (если раскомментировать с localhost — backend в контейнере не найдёт БД:
#    localhost внутри контейнера — это сам контейнер, а не сервис postgres).
# ВАРИАНТ B — локальный запуск без Docker (uvicorn): SQLite, создастся dev.db
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
# ВАРИАНТ C — внешний PostgreSQL: укажите реальный хост
# DATABASE_URL=postgresql+asyncpg://ecg_user:ecg_password@localhost:5432/ecg_analyzer

# Параметры PostgreSQL для docker-compose
POSTGRES_USER=ecg_user
POSTGRES_PASSWORD=ecg_password
POSTGRES_DB=ecg_analyzer
POSTGRES_PORT=5432

# Путь к папке с ЭКГ-файлами (.hea + .mat)
# Дефолт совпадает с текущим значением в ecg_loader.py
SIGNALS_DIR=./data/signals

# CORS: список origin'ов, которым разрешено обращаться к API
# Для dev: * (разрешить все)
# Для prod: укажите конкретные домены через запятую
ALLOWED_ORIGINS=*

# Пул соединений с БД (для 40 одновременных пользователей)
POOL_SIZE=10
MAX_OVERFLOW=20

# Секретный ключ (для будущей аутентификации, пока не используется)
SECRET_KEY=change-me-in-production

# Токен доступа к платформе («пропуск» на сайт).
# При старте записывается в таблицу platform_tokens (если она пуста),
# дальше проверка идёт по БД — новые токены можно добавлять туда вручную.
# Без валидного токена платформы регистрация на сайте невозможна.
PLATFORM_ACCESS_TOKEN=change-me-platform-token

# Порт, на котором запускается FastAPI (внутри контейнера)
BACKEND_PORT=8000

# ---- LLM (OpenAI-совместимый API: vLLM или бесплатный hosted) ----
# Внутри docker-compose backend ходит к vLLM по имени сервиса "llm".
# Бесплатные hosted API (ключ без карты):
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
#               LLM_MODEL=openai/gpt-oss-120b
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
#               (список актуальных :free моделей: GET /api/v1/models)
#   Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#               LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_API_KEY=
LLM_TIMEOUT=120
# Ошибка LLM всегда -> HTTP 503 (fallback-заглушек нет: отвечает только модель)

# ---- Наш LLM-модуль (ecgllm: setup_llm + process_text) ----
# true -> LLM вызывается через ecgllm WaveDescriptorInferencePiepeline;
# false -> напрямую через httpx (старое поведение)
LLM_VIA_MODULE=true
LLM_MAX_TOKENS=1024

# ---- ML-бэкенд анализа ЭКГ ----
# deterministic — scipy-анализатор (работает без весов)
# torch — реальная модель (требует веса и analyze_with_torch)
ML_BACKEND=deterministic

# ---- vLLM (сервис llm в docker-compose, требуется NVIDIA GPU!) ----
# Модель, которую скачает vLLM (HuggingFace id) или локальный путь в ./models
VLLM_MODEL=${LLM_MODEL}
# Размер батча, макс. длина контекста, утилизация VRAM
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_TENSOR_PARALLEL_SIZE=1
# Токен HuggingFace (если модель gated, напр. Llama)
HF_TOKEN=
# Порт vLLM внутри контейнера
VLLM_PORT=8000
# Порт vLLM на хосте (только для отладки; backend ходит по сети compose)
VLLM_HOST_PORT=8001
